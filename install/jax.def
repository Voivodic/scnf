Bootstrap: docker
From: nvidia/cuda:12.9.1-cudnn-devel-ubuntu24.04

%post
    # Update package lists and install Python and pip
    apt-get update && apt-get install -y \
        python3-pip \
        python3-venv

    # Upgrade pip
    python3 -m pip install --upgrade pip

    # Install JAX with CUDA 12 support
    pip install -U "jax[cuda12]"

%environment
    # Set environment variables to ensure CUDA libraries are found
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/usr/local/bin:$PATH

%labels
    Rodrigo Voivodic 
    Version 0.1
    Description A container with JAX and CUDA for GPU computation.

%help
    This container provides JAX with CUDA support.
    To run this container with GPU access, use the --nv flag:
    apptainer run --nv jax_cuda.sif
